# ─── Environment ───
NODE_ENV=development

# ─── OpenAI ───
# The app stores the user's API key locally (encrypted).
# No key here is needed.

# ─── AI Models ───
# Override defaults here — changes take effect on next app launch.
CHAT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-5-mini
VISION_FALLBACK_MODEL=gpt-5-mini
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15

# ─── Backend (optional — for auth & credits) ───
MEETVORA_API_URL=http://localhost:5001
